---
import type { ReleaseInfo } from '../lib/app-schema';
import { groups } from '../apps';
import TileGroup from './TileGroup.astro';

interface Props {
  releases: Map<string, ReleaseInfo>;
}
const { releases } = Astro.props;

let offset = 0;
const offsets = groups.map((g) => {
  const o = offset;
  offset += g.tiles.length;
  return o;
});
---

<main class="start-canvas" data-hscroll>
  <header class="start-head">
    <h1 class="start-title"><span class="start">Intelios</span></h1>
    <a class="start-user" href="https://github.com/Intelios" target="_blank" rel="noopener noreferrer" aria-label="Intelios on GitHub">
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <path d="M12 .5C5.65.5.5 5.65.5 12c0 5.08 3.29 9.39 7.86 10.91.58.11.79-.25.79-.55 0-.27-.01-1.17-.02-2.12-3.2.7-3.88-1.36-3.88-1.36-.52-1.33-1.28-1.68-1.28-1.68-1.04-.71.08-.7.08-.7 1.15.08 1.76 1.18 1.76 1.18 1.03 1.76 2.69 1.25 3.35.96.1-.75.4-1.25.72-1.54-2.55-.29-5.24-1.28-5.24-5.69 0-1.26.45-2.28 1.18-3.09-.12-.29-.51-1.46.11-3.04 0 0 .96-.31 3.15 1.18a10.9 10.9 0 0 1 5.74 0c2.19-1.49 3.15-1.18 3.15-1.18.62 1.58.23 2.75.11 3.04.74.81 1.18 1.83 1.18 3.09 0 4.42-2.69 5.39-5.26 5.68.41.36.78 1.06.78 2.14 0 1.55-.01 2.79-.01 3.17 0 .31.21.67.8.55A11.51 11.51 0 0 0 23.5 12C23.5 5.65 18.35.5 12 .5Z" />
      </svg>
    </a>
  </header>
  <div class="start-groups">
    {groups.map((group, i) => (
      <TileGroup group={group} releases={releases} indexOffset={offsets[i]} />
    ))}
  </div>
</main>

<script>
  import { initTilt, initLiveTiles, initHorizontalScroll, initTileZoom, initTileReturn } from '../scripts/metro';
  initHorizontalScroll();
  initTilt();
  initLiveTiles();
  initTileZoom();
  initTileReturn();
</script>
