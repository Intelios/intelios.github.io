---
import type { AppDefinition, ReleaseInfo } from '../lib/app-schema';
import { formatDate, formatSize, platformLabel } from '../lib/github';

interface Props {
  app: AppDefinition;
  release?: ReleaseInfo;
}
const { app, release } = Astro.props;
const dl = app.download;
const build = release?.build;
---

{app.status === 'in-development' ? (
  <div class="dl-list">
    <span class="dl-btn dl-btn--ghost">{app.statusNote ?? 'In development'}</span>
    {dl.kind === 'none' && dl.note && <p class="dl-note">{dl.note}</p>}
  </div>
) : dl.kind === 'source-zip' ? (
  <div class="dl-list">
    {release ? (
      <a class="dl-btn" href={release.zipballUrl}>
        {dl.label ?? 'Download'}
        <span class="dl-meta">{release.version} · {formatDate(release.date)}</span>
      </a>
    ) : app.github ? (
      <a class="dl-btn" href={`https://github.com/${app.github.owner}/${app.github.repo}/releases/latest`} target="_blank" rel="noopener noreferrer">
        View release on GitHub
      </a>
    ) : null}
    {dl.note && <p class="dl-note">{dl.note}</p>}
  </div>
) : dl.kind === 'assets' ? (
  <div class="dl-list">
    {build?.assets.map((a) => (
      <a class="dl-btn" href={a.url}>
        Download for {platformLabel[a.platform]}
        <span class="dl-meta">{build.version} · {formatSize(a.size)}</span>
      </a>
    ))}
    {release ? (
      <a class:list={['dl-btn', build && 'dl-btn--ghost']} href={release.zipballUrl}>
        Source code
        <span class="dl-meta">{release.version} · {formatDate(release.date)}</span>
      </a>
    ) : app.github ? (
      <a class="dl-btn" href={`https://github.com/${app.github.owner}/${app.github.repo}/releases/latest`} target="_blank" rel="noopener noreferrer">
        View release on GitHub
      </a>
    ) : null}
    {dl.note && <p class="dl-note">{dl.note}</p>}
  </div>
) : (
  <div class="dl-list">
    {dl.note && <p class="dl-note">{dl.note}</p>}
  </div>
)}
